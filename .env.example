# For Vercel/serverless deployments use your provider's pooled endpoint (Neon: hostname containing -pooler).
# Keep sslmode=require (do not append a second sslmode parameter).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/umka?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_CONTACT_EMAIL=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Upstash Redis REST credentials (required for shared serverless rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple private key must be stored as one line with literal \n characters.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Email delivery (Resend). In development, links are printed in the terminal if these are empty.
RESEND_API_KEY=""
EMAIL_FROM="UMKA <noreply@your-domain.kz>"

# Cloudflare Stream: private playback tokens
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_CODE=""

# Cloudflare R2: private bucket for book PDFs and covers. Do not expose this bucket publicly.
# Create an R2 API token with Object Read & Write limited to this one bucket.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BOOKS_BUCKET=""

# Public Hero images and thumbnails are stored in PostgreSQL; no media credentials needed.
