# For Vercel/serverless deployments use your provider's pooled endpoint (Neon: hostname containing -pooler).
# Keep sslmode=require (do not append a second sslmode parameter).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/umka?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# Email delivery (Resend). In development, links are printed in the terminal if these are empty.
RESEND_API_KEY=""
EMAIL_FROM="UMKA <noreply@your-domain.kz>"

# Cloudflare Stream: private playback tokens
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_CODE=""

# Cloudflare R2: private bucket for book PDFs and covers. Do not expose this bucket publicly.
# Create an R2 API token with Object Read & Write limited to this one bucket.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BOOKS_BUCKET=""

# Cloudflare R2: public bucket for marketing images (Hero, course, module, video, and book covers).
# Reuse the credentials above, but keep this bucket separate from the private book-PDF bucket.
# CLOUDFLARE_R2_IMAGES_PUBLIC_URL must be the public custom domain or R2.dev base URL for this bucket.
CLOUDFLARE_R2_IMAGES_BUCKET=""
CLOUDFLARE_R2_IMAGES_PUBLIC_URL="https://images.example.com"
# Optional: defaults to https://<CLOUDFLARE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_IMAGES_ENDPOINT=""
